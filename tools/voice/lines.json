[
 {
  "file": "83de7b187ee5.ogg",
  "text": "필살기 와요! 천천히 끝까지, 세 번 막아요!",
  "style": "URGENT",
  "key": "voice_ultimate_knight:3"
 },
 {
  "file": "c603c191bfd9.ogg",
  "text": "필살기 와요! 빠르게, 세 번 막아요!",
  "style": "URGENT",
  "key": "voice_ultimate_archer:3"
 },
 {
  "file": "047fc10c2016.ogg",
  "text": "필살기 와요! 자세 그대로 버텨요!",
  "style": "URGENT",
  "key": "voice_ultimate_hold"
 },
 {
  "file": "90c49ad98299.ogg",
  "text": "한 번 더!",
  "style": "URGENT",
  "key": "voice_answers_left:1"
 },
 {
  "file": "9a9bd83fde24.ogg",
  "text": "두 번 더!",
  "style": "URGENT",
  "key": "voice_answers_left:2"
 },
 {
  "file": "03aef8c592d4.ogg",
  "text": "막았어요! 좋아요!",
  "style": "URGENT",
  "key": "voice_ultimate_blocked"
 },
 {
  "file": "f1105a079b3b.ogg",
  "text": "맞았어요. 괜찮아요, 계속 가요!",
  "style": "URGENT",
  "key": "voice_ultimate_hit"
 },
 {
  "file": "fb23592fccff.ogg",
  "text": "거의 다 왔어요!",
  "style": "COACH",
  "key": "voice_boss_low"
 },
 {
  "file": "03661082090a.ogg",
  "text": "조금만 더 깊게요!",
  "style": "COACH",
  "key": "voice_shallow"
 },
 {
  "file": "fdfd63f7d59c.ogg",
  "text": "다리를 앞뒤로 벌려야 런지로 세요",
  "style": "COACH",
  "key": "battle_not_split"
 },
 {
  "file": "3a2d8c360e16.ogg",
  "text": "천천히요!",
  "style": "COACH",
  "key": "voice_style_too_quick"
 },
 {
  "file": "adeb16348317.ogg",
  "text": "끝까지요!",
  "style": "COACH",
  "key": "voice_style_not_full"
 },
 {
  "file": "e86d9746c7a9.ogg",
  "text": "더 빠르게요!",
  "style": "COACH",
  "key": "voice_style_lagging"
 },
 {
  "file": "24ca000d341d.ogg",
  "text": "왼발 앞으로!",
  "style": "COACH",
  "key": "voice_leg_left"
 },
 {
  "file": "4f3c10089055.ogg",
  "text": "오른발 앞으로!",
  "style": "COACH",
  "key": "voice_leg_right"
 },
 {
  "file": "19131ffad519.ogg",
  "text": "좋아요, 시작해요!",
  "style": "COACH",
  "key": "voice_ready"
 },
 {
  "file": "c6e421f51706.ogg",
  "text": "십 초 뒤에 다음 던전 시작해요",
  "style": "COACH",
  "key": "voice_rest_ten"
 },
 {
  "file": "11b3fffa8cb2.ogg",
  "text": "시작!",
  "style": "COACH",
  "key": "voice_rest_go"
 },
 {
  "file": "e85326f66a76.ogg",
  "text": "10 콤보!",
