  "file": "eeb13391bc87.ogg",
  "text": "벌써 270초! 멋져요!",
  "style": "CAT",
  "key": "cat_line_milestone_2:270"
 },
 {
  "file": "6cda055843b2.ogg",
  "text": "벌써 300초! 멋져요!",
