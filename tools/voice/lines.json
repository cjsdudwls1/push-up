 },
 {
  "file": "a00c8cd9c859.ogg",
  "text": "100 콤보!",
  "style": "COACH",
  "key": "voice_combo:100"
 },
 {
  "file": "aeb781f2bdc9.ogg",
  "text": "화면 안으로 들어와 주세요",
  "style": "COACH",
  "key": "placement_step_into_view"
 },
 {
  "file": "87cb3605f3a0.ogg",
  "text": "폰에 조금 더 가까이 와 주세요",
  "style": "COACH",
  "key": "placement_come_closer"
 },
 {
  "file": "b2c4bfbbfb4d.ogg",
  "text": "폰을 조금 더 멀리 두세요",
  "style": "COACH",
  "key": "placement_move_back"
 },
 {
  "file": "f88fde8a37e2.ogg",
  "text": "아래쪽이 잘려요. 폰을 조금 뒤로 두거나 아래로 기울여 주세요",
  "style": "COACH",
  "key": "placement_show_below"
 },
 {
  "file": "f47043e2f327.ogg",
  "text": "위쪽이 잘려요. 폰을 조금 뒤로 두거나 위로 기울여 주세요",
  "style": "COACH",
  "key": "placement_show_above"
 },
 {
  "file": "49cbe7075f62.ogg",
  "text": "화면 가운데로 와 주세요",
  "style": "COACH",
  "key": "placement_center"
 },
 {
  "file": "0dd49120a95a.ogg",
  "text": "머리가 폰을 향하게 엎드려 주세요. 옆모습은 못 세요",
  "style": "COACH",
  "key": "placement_face_floor"
 },
 {
  "file": "94032a56eb9c.ogg",
  "text": "몸 앞쪽이 폰을 향하게 해 주세요",
  "style": "COACH",
  "key": "placement_face_standing"
 },
 {
  "file": "9754d550441a.ogg",
  "text": "몸이 잘 안 보여요. 더 밝은 곳에서 해 볼까요?",
  "style": "COACH",
  "key": "placement_clearer"
 },
 {
  "file": "9188f961f21b.ogg",
  "text": "폰이 흔들려요. 기대 세워둘 곳이 있을까요?",
  "style": "COACH",
  "key": "quality_unstable_camera"
 },
 {
  "file": "06c4d5f92b17.ogg",
  "text": "자세를 다시 잡는 동안 기다릴게요",
  "style": "COACH",
  "key": "quality_subject_switch"
 },
 {
  "file": "8d65e466cb5d.ogg",
  "text": "천천히 한 개씩 세어 볼게요",
  "style": "COACH",
  "key": "quality_implausible_rate"
 },
 {
  "file": "c0bedef217d0.ogg",
  "text": "팔을 펴고 엎드려 주세요",
  "style": "COACH",
  "key": "placement_start_pushup"
 },
 {
  "file": "01c32cd1b184.ogg",
  "text": "플랭크 자세를 잡아 주세요",
  "style": "COACH",
  "key": "placement_start_plank"
 },
 {
  "file": "8789f8dc4d90.ogg",
  "text": "똑바로 서 주세요",
  "style": "COACH",
  "key": "placement_start_squat"
 },
 {
  "file": "5a31795ae6d2.ogg",
  "text": "한 발을 앞으로 내고 서 주세요",
  "style": "COACH",
  "key": "placement_start_lunge"
 },
 {
  "file": "68b1ca969d66.ogg",
  "text": "바에 매달려 주세요",
  "style": "COACH",
  "key": "placement_start_pull_up"
 },
 {
  "file": "43d4fbd0f4c5.ogg",
  "text": "봉을 잡고 팔을 펴 주세요",
  "style": "COACH",
  "key": "placement_start_dip"
 },
 {
  "file": "2d9bfe1d2780.ogg",
  "text": "든든해요, 냥~",
  "style": "CAT",
  "key": "cat_line_calm_1"
 },
 {
  "file": "14589849a7bb.ogg",
  "text": "좋아요, 그대로요!",
