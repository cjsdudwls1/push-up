  "key": "cat_line_near_miss_2"
 },
 {
  "file": "5f741ce1fc9f.ogg",
  "text": "살려 줘요, 냥!!",
  "style": "CAT",
  "key": "cat_line_panic_1"
 },
 {
  "file": "f8b447f31e4b.ogg",
  "text": "제발 밀어 줘요!!",
  "style": "CAT",
  "key": "cat_line_panic_2"
 },
 {
  "file": "2251119f69ac.ogg",
  "text": "살았다냥!",
  "style": "CAT",
  "key": "cat_line_saved_1"
 },
 {
  "file": "16d070a30f07.ogg",
  "text": "고마워요, 냥! 살았어요!",
  "style": "CAT",
  "key": "cat_line_saved_2"
 },
 {
  "file": "ac5bc977d93b.ogg",
  "text": "휴… 살았다냥!",
  "style": "CAT",
  "key": "cat_line_saved_3"
 },
 {
  "file": "a4e69ed248e1.ogg",
  "text": "무서워요, 냥…!",
  "style": "CAT",
  "key": "cat_line_scared_1"
 },
 {
  "file": "2375165f9c93.ogg",
  "text": "천장이 너무 가까워요!",
  "style": "CAT",
  "key": "cat_line_scared_2"
 },
 {
  "file": "61fb78b11ead.ogg",
  "text": "어… 천장이 내려와요, 냥?",
  "style": "CAT",
  "key": "cat_line_uneasy_1"
 },
 {
  "file": "614a9306f74c.ogg",
  "text": "조금 무서워지는데요…",
  "style": "CAT",
  "key": "cat_line_uneasy_2"
 },
 {
  "file": "53191fdb44e0.ogg",
  "text": "천장이 무서워요… 지켜 줄 거죠?",
  "style": "CAT",
  "key": "cat_line_waiting_1"
 },
 {
  "file": "d47c907ceeb6.ogg",
