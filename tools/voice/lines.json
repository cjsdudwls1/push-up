  "file": "dbc039b90d25.ogg",
  "text": "조금만 더 깊게요, 냥!",
  "style": "CAT",
  "key": "cat_line_near_miss_1"
 },
 {
  "file": "4fef5c00e690.ogg",
  "text": "거의 다 왔어요! 한 번 더!",
