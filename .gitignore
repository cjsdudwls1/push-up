*.iml
.gradle/
/local.properties
/.idea/
.DS_Store
/build
/captures
.externalNativeBuild
.cxx
local.properties
/app/build
/core/build

# Signing material must never be committed.
*.jks
*.keystore
keystore.properties

# The one exception, and only this one. app/debug.keystore holds Android's standard debug
# credentials (androiddebugkey / android / android) — publicly documented, useless for Play, and
# the only way a debug APK built on one machine can install over one built on another. Without it
# every CI runner generates a fresh key and each build refuses to update the last.
!app/debug.keystore

# Per-project Firebase config; generate it in the Firebase console.
google-services.json

# Scratch git worktrees the agent harness creates for parallel work. They are full nested checkouts
# of this repo and are removed when the work finishes; committing one would nest the repo inside
# itself.
.claude/worktrees/
